        {
          "info": {
            "name": "Modify an order",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.tradier.com/v1/accounts/:account_id/orders/:order_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Tradier account identifier."
              },
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "Order identifier."
              }
            ]
          },
          "docs": "Modify an order"
        },
        {
          "info": {
            "name": "Cancel an order",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tradier.com/v1/accounts/:account_id/orders/:order_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Tradier account identifier."
              },
              {
                "name": "order_id",
                "value": "",
                "type": "path",
                "description": "Order identifier."
              }
            ]
          },
          "docs": "Cancel an order"
        }
      ]
    },
